@startuml casos-de-uso
title Sistema de Aluguel de Carros - Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle

actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Banco" as Banco
actor "Empresa" as Empresa
Agente <|-- Banco
Agente <|-- Empresa

rectangle "Sistema de Aluguel de Carros" {
  usecase "Cadastrar-se" as UC1
  usecase "Autenticar (login)" as UC2
  usecase "Manter perfil do cliente" as UC3
  usecase "Introduzir pedido de aluguel" as UC4
  usecase "Modificar pedido" as UC5
  usecase "Consultar pedidos e status" as UC6
  usecase "Cancelar pedido" as UC7
  usecase "Associar contrato de crédito" as UC8
  usecase "Avaliar pedido\n(parecer financeiro)" as UC9
  usecase "Executar contrato" as UC10
  usecase "Manter clientes (CRUD)" as UC11
  usecase "Manter automóveis (CRUD)" as UC12
}

Cliente --> UC1
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Cliente --> UC7

Agente --> UC5
Agente --> UC6
Agente --> UC7
Agente --> UC9
Agente --> UC10
Agente --> UC11
Agente --> UC12
Banco --> UC8

UC4 .> UC8 : <<extend>>
UC1 .> UC2 : <<include>>
UC4 .> UC2 : <<include>>
UC5 .> UC2 : <<include>>
UC9 .> UC2 : <<include>>

note right of UC5
  Cliente: só enquanto PENDENTE.
  Agente: enquanto PENDENTE ou APROVADO.
end note
note right of UC7
  Permitido em PENDENTE ou APROVADO.
end note
note right of UC10
  Só para pedidos APROVADOS.
end note
@enduml
