# Variáveis de ambiente do back-end (o Spring NÃO lê este arquivo sozinho: defina-as no terminal ou na IDE).
# Só são necessárias com o Supabase; o perfil "dev" não precisa de nenhuma.

# URL JDBC do Supabase, com usuário e senha na própria URL
SUPABASE_DB_URL=jdbc:postgresql://HOST:5432/postgres?user=USUARIO&password=SENHA&sslmode=require

# Chave de assinatura do JWT (mínimo 32 caracteres)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres

# Opcional: origem permitida no CORS (padrão http://localhost:5173)
# APP_CORS_ALLOWED_ORIGIN=https://seu-front-end.exemplo.com
